# AI-yordamchi — muhit o'zgaruvchilari namunasi.
# Bu faylni .env nomi bilan nusxalang. Ko'p sozlamalarni boshqaruv panelidan ham kiritish mumkin
# (python -m yordamchi --panel). .env dagi qiymat paneldagidan ustun turadi.

# --- LLM: istalgan OpenAI-mos provayder (tool calling'ni qo'llashi kerak) ---------------------
# Eng oson yo'l: panel -> Sozlamalar -> Provayder (manzil va model o'zi to'ladi).
# Namunalar (LLM_PROVIDER / LLM_BASE_URL / LLM_MODEL):
#   anthropic   https://api.anthropic.com/v1                              claude-sonnet-5-5
#   openai      https://api.openai.com/v1                                 gpt-4o-mini
#   gemini      https://generativelanguage.googleapis.com/v1beta/openai   gemini-2.5-flash
#   deepseek    https://api.deepseek.com/v1                               deepseek-chat
#   mistral     https://api.mistral.ai/v1                                 mistral-large-latest
#   xai         https://api.x.ai/v1
#   groq        https://api.groq.com/openai/v1                            llama-3.3-70b-versatile
#   openrouter  https://openrouter.ai/api/v1      (yuzlab modellar bitta kalit bilan)
#   ollama      http://localhost:11434/v1         (kompyuterda, kalit shart emas)
#   custom      o'z serveringiz (vLLM, LiteLLM, gateway): https://llm.example.lan
LLM_PROVIDER=custom
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Ichki tarmoq: sertifikat boshqa nom uchun berilgan bo'lsa (reverse proxy). Tekshiruv o'chirilmaydi.
# LLM_TLS_SERVER_NAME=ai.example.com
# LLM_VERIFY_TLS=true          # true / false
# LLM_CA_FILE=C:/certs/ca.pem  # ichki sertifikat markazi

# --- Nutq (STT/TTS) — ovozli rejim uchun ------------------------------------------------------
# Bo'sh bo'lsa LLM manzili va kaliti ishlatiladi (faqat custom provayderda: OpenAI, Claude va boshqalar
# o'zbekcha STT/TTS bermaydi — nutq serverini alohida ko'rsating).
# SPEECH_BASE_URL=
# SPEECH_API_KEY=
# SPEECH_STT_PATH=/v1/stt/transcribe     # multipart "file" (wav) -> {"text": "..."}
# SPEECH_TTS_PATH=/v1/tts/stream         # JSON {"text", "language", "voice"} -> PCM 24 kHz int16 oqimi
# SPEECH_LANGUAGE=uz
# TTS_VOICE=
# TTS_SPEED=1.0

# --- Plugin'lar -----------------------------------------------------------------------------
# GEMINI_API_KEY=                          # "Ekranni ko'rish" plugin'i uchun

# --- Boshqaruv paneli -----------------------------------------------------------------------
# API_HOST=127.0.0.1       # 0.0.0.0 = tarmoqdan (telefon) ham — token majburiy
# API_PORT=8765

# --- Ovoz -----------------------------------------------------------------------------------
# WAKE_THRESHOLD=0.4
# DUCK_LEVEL=0.3
# PTT_KEY=J                # Ctrl+Alt+J
# INPUT_DEVICE=
# OUTPUT_DEVICE=
